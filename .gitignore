# Python
__pycache__/
*.py[cod]
.venv/
.venv-picaso/
.pytest_cache/
.ruff_cache/

# Pipeline caches (regenerable)
data/cache/

# The data artifact lives in GitHub Releases, not git (a 6k build is ~90 MB).
# data/RELEASE (committed) names the release tag; scripts/fetch_data.py downloads it.
data/planets.json
# Ships as a release asset beside it: what the build was made from, and the drift probe's
# baseline (pipeline/drift.py). Regenerated per release, so committing it would be pure churn.
data/manifest.json
# Scratch output of the one-planet newsjack fast path (`pipeline build --planet … --out`).
data/newsjack*.json

# Built static site (regenerable via `python -m web.build`; the Dockerfile builds it)
dist/

# Local Claude Code tooling / session data
.claude/

# Generated by `tools/exohub.py mprocs` — machine-specific absolute paths
mprocs.yaml

# OS
.DS_Store

# Private working notes live in a separate repo, not here. `docs/notes` is a symlink to that
# checkout so both are readable in one session while staying two repositories. Never tracked:
# a committed symlink is just its target path, which would publish where the notes live.
# Recreate in a fresh worktree with:  ln -sfn ~/Documents/Dev/<notes-checkout> docs/notes
docs/notes
docs/marketing/
docs/DEFECTS.md
